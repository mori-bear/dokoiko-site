---
const { title, description, image } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {image && <meta property="og:image" content={image}>}
  <link rel="canonical" href={Astro.url.href}>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WCJKVC2DXY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WCJKVC2DXY');
  </script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
      color: #333;
      background: #fff;
      font-size: 16px;
      line-height: 1.8;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }
    .site-header {
      padding: 16px 20px;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .site-logo {
      font-size: 18px;
      font-weight: bold;
      letter-spacing: 0.05em;
    }
    .site-nav { font-size: 12px; color: #999; }
    .site-footer {
      padding: 40px 20px;
      border-top: 1px solid #eee;
      text-align: center;
      font-size: 12px;
      color: #999;
    }
    .site-footer a { color: #999; margin: 0 8px; }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="https://tabidokoiko.com" class="site-logo">どこ行こ？</a>
    <nav class="site-nav">
      <a href="/destinations/">目的地一覧</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <p>交通・宿泊情報は各社公式サイトでご確認ください。本サービスはアフィリエイト広告（楽天トラベル・じゃらん）を含みます。</p>
    <p style="margin-top: 12px;">
      <a href="https://tabidokoiko.com/pages/about.html">このサイトについて</a>
      <a href="https://tabidokoiko.com/pages/privacy.html">プライバシーポリシー</a>
      <a href="https://tabidokoiko.com/pages/disclaimer.html">免責事項</a>
    </p>
    <p style="margin-top: 12px;">© 2026 どこ行こ？</p>
  </footer>
</body>
</html>
