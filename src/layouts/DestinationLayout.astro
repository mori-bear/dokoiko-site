---
const { title, description, image } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {image && <meta property="og:image" content={image}>}
  <link rel="canonical" href={Astro.url.href}>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WCJKVC2DXY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WCJKVC2DXY');
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap');

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Noto Sans JP', 'Hiragino Sans', sans-serif;
      color: #2d2d2d;
      background: #fff;
      font-size: 16px;
      line-height: 1.9;
      letter-spacing: 0.02em;
    }

    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    .site-header {
      padding: 20px 24px;
      border-bottom: 1px solid #e8e8e8;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fff;
    }

    .site-logo {
      font-family: 'Noto Serif JP', serif;
      font-size: 20px;
      font-weight: 400;
      letter-spacing: 0.1em;
      color: #1a1a1a;
    }

    .site-nav {
      font-size: 12px;
      color: #888;
      letter-spacing: 0.05em;
    }

    .site-nav a {
      color: #888;
      margin-left: 16px;
    }

    .site-footer {
      padding: 48px 24px;
      border-top: 1px solid #e8e8e8;
      text-align: center;
      font-size: 11px;
      color: #aaa;
      letter-spacing: 0.05em;
      line-height: 2;
    }

    .site-footer a {
      color: #aaa;
      margin: 0 10px;
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a href="/" class="site-logo">どこ行こ？</a>
    <nav class="site-nav">
      <a href="/destinations/">目的地一覧</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <p>交通・宿泊情報は各社公式サイトでご確認ください。本サービスはアフィリエイト広告（楽天トラベル・じゃらん）を含みます。</p>
    <p style="margin-top: 12px;">
      <a href="https://tabidokoiko.com/pages/about.html">このサイトについて</a>
      <a href="https://tabidokoiko.com/pages/privacy.html">プライバシーポリシー</a>
      <a href="https://tabidokoiko.com/pages/disclaimer.html">免責事項</a>
    </p>
    <p style="margin-top: 12px;">© 2026 どこ行こ？</p>
  </footer>
</body>
</html>
