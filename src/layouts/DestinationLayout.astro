---
import '../styles/global.css';
const { title, description, ogImage, canonicalUrl } = Astro.props;
const siteUrl = 'https://tabidokoiko.com';
const imageUrl = ogImage || `${siteUrl}/assets/ogp.png`;
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="どこ行こ？">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl || siteUrl}>
  <meta property="og:image" content={imageUrl}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={imageUrl}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl || siteUrl}>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WCJKVC2DXY"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-WCJKVC2DXY');
  </script>
</head>
<body class="bg-white text-gray-900 font-sans antialiased">
  <header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-gray-100">
    <div class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
      <a href="/" class="text-lg font-bold tracking-tight text-gray-900 hover:text-blue-600 transition-colors">
        どこ行こ？
      </a>
      <nav class="flex gap-6 text-sm text-gray-600">
        <a href="/destinations" class="hover:text-gray-900 transition-colors">目的地一覧</a>
        <a href="/pages/about.html" class="hover:text-gray-900 transition-colors">サイトについて</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="border-t border-gray-100 mt-20 py-10 text-center text-xs text-gray-400">
    <p class="mb-3">交通・宿泊情報は各社公式サイトでご確認ください。本サービスはアフィリエイト広告（楽天トラベル・じゃらん）を含みます。</p>
    <nav class="flex justify-center gap-6 mb-3">
      <a href="/pages/about.html" class="hover:text-gray-600">このサイトについて</a>
      <a href="/pages/privacy.html" class="hover:text-gray-600">プライバシーポリシー</a>
      <a href="/pages/disclaimer.html" class="hover:text-gray-600">免責事項</a>
    </nav>
    <p>© 2026 どこ行こ？</p>
  </footer>
</body>
</html>
