    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 36px;
  }
  .location-btn {
    padding: 13px 14px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-size: 11px;
    color: #888;
    cursor: pointer;
    background: #fff;
    white-space: nowrap;
