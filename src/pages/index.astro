---
import DestinationLayout from '../layouts/DestinationLayout.astro';
import destinations from '../data/destinations.json';
import fs from 'fs';
import path from 'path';
import { feature } from 'topojson-client';
import { geoMercator, geoPath } from 'd3-geo';

const heroDir = path.join(process.cwd(), 'public/images/hero');
const heroImages = fs.existsSync(heroDir)
  ? fs.readdirSync(heroDir)
      .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
      .sort()
      .map(f => `/images/hero/${f}`)
  : [];

const destCount = (destinations as any[]).length;

// ── Japan map: build-time TopoJSON → SVG paths ──────────────────────────────
const PREF_REGION: Record<number, string> = {
  1: '北海道',
  2: '東北', 3: '東北', 4: '東北', 5: '東北', 6: '東北', 7: '東北',
  8: '関東', 9: '関東', 10: '関東', 11: '関東', 12: '関東', 13: '関東', 14: '関東',
  15: '中部', 16: '中部', 17: '中部', 18: '中部', 19: '中部', 20: '中部',
  21: '中部', 22: '中部', 23: '中部',
  24: '近畿', 25: '近畿', 26: '近畿', 27: '近畿', 28: '近畿', 29: '近畿', 30: '近畿',
  31: '中国', 32: '中国', 33: '中国', 34: '中国', 35: '中国',
  36: '四国', 37: '四国', 38: '四国', 39: '四国',
  40: '九州', 41: '九州', 42: '九州', 43: '九州', 44: '九州', 45: '九州', 46: '九州',
  47: '沖縄',
};

const REGION_COLORS: Record<string, string> = {
  '北海道': '#c4e0d0', '東北': '#bbd9c5', '関東': '#c8e6d5',
  '中部': '#b8dcc8', '近畿': '#c0e2cc', '中国': '#b4d8c2',
  '四国': '#bce0ca', '九州': '#b0d4be', '沖縄': '#a8ccb5',
};

const SVG_W = 340;
const SVG_H = 500;

type MapRegion = { region: string; paths: string[] };
let mapRegions: MapRegion[] = [];

try {
  const res = await fetch('https://raw.githubusercontent.com/dataofjapan/land/master/japan.topojson');
  const topo = await res.json();
  const geo = (feature as any)(topo, topo.objects.japan);
  const feats: any[] = geo.features;

  const proj = (geoMercator() as any).fitSize([SVG_W, SVG_H], geo);
  const pg   = (geoPath()     as any).projection(proj);

  const grp: Record<string, string[]> = {};
  for (const f of feats) {
    const region = PREF_REGION[Number(f.properties?.id)];
    if (!region) continue;
    const d: string | null = pg(f);
    if (d) (grp[region] ??= []).push(d);
  }
  mapRegions = ['北海道','東北','関東','中部','近畿','中国','四国','九州','沖縄']
    .filter(r => grp[r])
    .map(r => ({ region: r, paths: grp[r] }));
} catch (e) {
  console.warn('[map] TopoJSON fetch failed:', e);
}
---

<DestinationLayout
  title="どこ行こ？ — まだ知らない街と、出会おう。"
  description={`出発地と日数を選ぶだけで旅先が決まる。日本全国${destCount}か所から、あなたにぴったりの旅先をご提案します。`}
>

<style>
