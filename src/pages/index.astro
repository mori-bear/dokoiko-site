    font-size: 12px;
    color: rgba(255,255,255,0.75);
    letter-spacing: 0.18em;
  }
  /* ── App Section ── */
  .app-section {
    max-width: 560px;
    margin: 0 auto;
    padding: 72px 24px 80px;
  }
  .app-heading {
    font-family: 'Noto Serif JP', serif;
    font-size: 24px;
    font-weight: 400;
    color: #1a1a1a;
    letter-spacing: 0.06em;
    text-align: center;
    margin-bottom: 48px;
  }
  .form-block { margin-bottom: 32px; }
  .form-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: #aaa;
    margin-bottom: 10px;
  }
  .departure-row { display: flex; gap: 8px; align-items: stretch; }
