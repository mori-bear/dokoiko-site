---
import DestinationLayout from '../layouts/DestinationLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

const articlesDir = join(process.cwd(), 'src/data/articles');
const files = readdirSync(articlesDir).filter(f => f.endsWith('.json'));
const destinations = files.map(f =>
  JSON.parse(readFileSync(join(articlesDir, f), 'utf-8'))
).slice(0, 6);
---

<DestinationLayout
  title="どこ行こ？ — まだ知らない街と、出会おう。"
  description="まだ知らない街と、出会おう。出発地と日程を選ぶだけで、行ったことのない日本の街に出会えます。"
  canonicalUrl="https://tabidokoiko.com/"
>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-slate-900 to-blue-950 text-white py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-blue-300 text-sm font-medium mb-4 tracking-widest uppercase">Discover Japan</p>
      <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-tight">
        旅先、1分で決まります。
      </h1>
      <p class="text-white/70 text-lg md:text-xl mb-10">
        出発地と日程を選ぶだけで、ちゃんと行ける旅先を出します。
      </p>
      <a
        href="https://tabidokoiko.com"
        class="inline-block bg-white text-slate-900 font-bold px-10 py-4 rounded-2xl text-lg hover:bg-blue-50 transition-colors"
      >
        どこ行こ？ →
      </a>
    </div>
  </section>

  <!-- Featured destinations -->
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-gray-900 mb-2">読み物：旅先ガイド</h2>
    <p class="text-gray-500 mb-8">知らなかった旅先との出会い方。</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {destinations.map((dest: any) => (
        <a
          href={`/destinations/${dest.id}`}
          class="group block rounded-xl overflow-hidden border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all"
        >
          {dest.image ? (
            <div class="aspect-video overflow-hidden">
              <img
                src={dest.image}
                alt={dest.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          ) : (
            <div class="aspect-video bg-gradient-to-br from-blue-100 to-teal-100 flex items-center justify-center">
              <span class="text-4xl">🏝️</span>
            </div>
          )}
          <div class="p-4">
            <p class="text-xs text-gray-400 mb-1">{dest.prefecture}</p>
            <h3 class="text-lg font-bold text-gray-900 mb-1">{dest.name}</h3>
            <p class="text-sm text-gray-500 italic">「{dest.catch}」</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a
        href="/destinations"
        class="text-blue-600 font-medium hover:underline"
      >
        すべての旅先ガイドを見る →
      </a>
    </div>
  </section>

</DestinationLayout>
