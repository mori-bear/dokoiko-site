    border-color: #2A6049;
    color: #fff;
  }

  /* ── SVG map ── */
  .japan-svg { width: 100%; height: auto; overflow: visible; }
  .jp-region { cursor: pointer; }
  .jp-path {
    stroke: #fff;
    stroke-width: 0.4;
    stroke-linejoin: round;
    transition: fill 0.2s;
