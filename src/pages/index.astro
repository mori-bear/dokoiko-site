</style>

  <!-- ① Hero Slideshow -->
  <div class="hero">
    {heroImages.length > 0 ? (
      heroImages.map((src, i) => (
        <img
          src={src}
          alt="旅の風景"
          class:list={['hero-slide', { 'is-active': i === 0 }]}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      ))
    ) : (
      <div class="hero-bg"></div>
    )}
    <div class="hero-overlay">
      <h1 class="hero-catch">まだ知らない街と、出会おう。</h1>
      <p class="hero-sub">出発地と日数を選ぶだけ</p>
    </div>
  </div>

  <!-- ② 旅先提案UI -->
  <section class="app-section" id="app">
    <h2 class="app-heading">旅先を見つける</h2>

    <div class="form-block">
      <label class="form-label" for="departure-select">出発地</label>
      <div class="departure-row">
        <select id="departure-select" class="departure-select">
          <!-- populated by JS -->
        </select>
        <button id="location-btn" type="button" class="location-btn">現在地</button>
      </div>
    </div>

    <div class="form-block">
      <span class="form-label">旅の長さ</span>
      <div class="toggle-row">
        <button type="button" data-stay="daytrip" class="toggle-btn">日帰り</button>
        <button type="button" data-stay="1night" class="toggle-btn active">1泊</button>
        <button type="button" data-stay="2night" class="toggle-btn">2泊以上</button>
      </div>
    </div>

    <div class="form-block">
      <span class="form-label">テーマ（任意）</span>
      <div class="toggle-row">
        <button type="button" data-theme="" class="toggle-btn active">こだわらない</button>
        <button type="button" data-theme="温泉" class="toggle-btn">温泉</button>
        <button type="button" data-theme="絶景" class="toggle-btn">絶景</button>
        <button type="button" data-theme="海" class="toggle-btn">海</button>
        <button type="button" data-theme="街歩き" class="toggle-btn">街歩き</button>
        <button type="button" data-theme="グルメ" class="toggle-btn">グルメ</button>
      </div>
    </div>

    <button id="go-btn" type="button" class="go-btn">どこ行こ？</button>
    <p id="form-error" class="form-error" hidden></p>

    <!-- Result (hidden until go clicked) -->
