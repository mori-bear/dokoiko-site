---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';

const regions = ['北海道', '東北', '関東', '中部', '近畿', '中国', '四国', '九州', '沖縄'];
const byRegion = regions.map(region => ({
  region,
  items: (destinations as any[]).filter(d => d.region === region)
})).filter(r => r.items.length > 0);
---

<DestinationLayout
  title="目的地一覧 | どこ行こ？"
  description="日本全国1163か所の旅先一覧。地域から探せます。"
>
<style>
  .list-hero {
    padding: 48px 24px 32px;
    text-align: center;
    border-bottom: 1px solid #ebebeb;
  }
  .list-hero-label {
    font-size: 11px; letter-spacing: 0.15em;
    color: #aaa; display: block; margin-bottom: 12px;
  }
  .list-hero-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 26px; font-weight: 400;
    color: #1a1a1a; letter-spacing: 0.05em;
  }
  .list-hero-count {
    font-size: 13px; color: #aaa; margin-top: 8px;
  }

  .list-content { max-width: 680px; margin: 0 auto; padding: 0 24px 80px; }

  .region-nav {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid #ebebeb;
    margin-bottom: 40px;
  }
  .region-nav-btn {
    padding: 6px 14px;
    border: 1px solid #ddd;
    border-radius: 20px;
    font-size: 12px;
    color: #666;
    letter-spacing: 0.05em;
    transition: all 0.2s;
  }
  .region-nav-btn:hover { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  .region-block { margin-bottom: 48px; }
  .region-block-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px; font-weight: 400;
    color: #1a1a1a; letter-spacing: 0.05em;
    padding-bottom: 12px;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 16px;
  }
  .dest-list { display: flex; flex-direction: column; }
  .dest-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid #f0f0f0;
    font-size: 14px;
  }
  .dest-item-left { display: flex; align-items: center; gap: 10px; }
  .dest-item-name { color: #1a1a1a; }
  .dest-item-tags { display: flex; gap: 4px; }
  .dest-item-tag {
    font-size: 10px; color: #aaa;
    border: 1px solid #eee;
    padding: 1px 6px; border-radius: 10px;
  }
  .dest-item-pref { font-size: 11px; color: #aaa; }
</style>

  <div class="list-hero">
    <span class="list-hero-label">DESTINATIONS</span>
    <h1 class="list-hero-title">目的地一覧</h1>
    <p class="list-hero-count">全{(destinations as any[]).length}か所</p>
  </div>

  <div class="list-content">

    <nav class="region-nav">
      {regions.map(r => (
        <a href={`#${r}`} class="region-nav-btn">{r}</a>
      ))}
    </nav>

    {byRegion.map(({ region, items }) => (
      <div class="region-block" id={region}>
        <h2 class="region-block-title">{region}</h2>
        <div class="dest-list">
          {items.map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="dest-item">
              <div class="dest-item-left">
                <span class="dest-item-name">{d.name}</span>
                <div class="dest-item-tags">
                  {d.tags?.slice(0, 2).map((tag: string) => (
                    <span class="dest-item-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <span class="dest-item-pref">{d.prefecture} →</span>
            </a>
          ))}
        </div>
      </div>
    ))}

  </div>
</DestinationLayout>
