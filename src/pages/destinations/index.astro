---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';
// @ts-ignore

import destsData from '../../data/destinations.json';
const articlesDir = join(process.cwd(), 'src/data/articles');
const files = readdirSync(articlesDir).filter(f => f.endsWith('.json'));
const destsMap = Object.fromEntries((destsData as any[]).map((d: any) => [d.id, d]));
const destinations = files.map(f => {
  const article = JSON.parse(readFileSync(join(articlesDir, f), 'utf-8'));
  const id = article.id || f.replace('.json', '');
  const dest = destsMap[id] || {};
  return { ...dest, ...article, id, tags: article.tags || dest.tags || [] };
});
---

<DestinationLayout
  title="目的地一覧 | どこ行こ？"
  description="島旅・秘境・自然スポットなど、どこ行こ？が選んだ国内旅行先の読み物記事一覧。"
  canonicalUrl="https://tabidokoiko.com/destinations"
>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">目的地一覧</h1>
    <p class="text-gray-500 mb-10">島旅・絶景・秘境。知らなかった旅先と出会おう。</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {destinations.map((dest: any) => (
        <a
          href={`/destinations/${dest.id}`}
          class="group block rounded-xl overflow-hidden border border-gray-200 hover:border-blue-300 hover:shadow-md transition-all"
        >
          {dest.image ? (
            <div class="aspect-video overflow-hidden">
              <img
                src={dest.image}
                alt={dest.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
          ) : (
            <div class="aspect-video bg-gradient-to-br from-blue-100 to-teal-100 flex items-center justify-center">
              <span class="text-4xl">🏝️</span>
            </div>
          )}
          <div class="p-4">
            <div class="flex flex-wrap gap-1 mb-2">
              {dest.tags.slice(0, 3).map((tag: string) => (
                <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="text-lg font-bold text-gray-900 mb-1">
              {dest.name}
              <span class="text-sm font-normal text-gray-400 ml-1">{dest.prefecture}</span>
            </h2>
            <p class="text-sm text-gray-600 line-clamp-2">{dest.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href="https://tabidokoiko.com"
        class="inline-block bg-blue-600 text-white font-bold px-8 py-3 rounded-xl hover:bg-blue-700 transition-colors"
      >
        出発地から旅先を探す →
      </a>
    </div>
  </div>
</DestinationLayout>
