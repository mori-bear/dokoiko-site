---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';

const regions = ['北海道', '東北', '関東', '中部', '近畿', '中国', '四国', '九州', '沖縄'];
const byRegion = regions.map(region => ({
  region,
  items: (destinations as any[]).filter(d => d.region === region)
})).filter(r => r.items.length > 0);

// 地方 → 都道府県マップ
const REGION_PREFS: Record<string, string[]> = {
  '北海道': ['北海道'],
  '東北': ['青森県','岩手県','宮城県','秋田県','山形県','福島県'],
  '関東': ['茨城県','栃木県','群馬県','埼玉県','千葉県','東京都','神奈川県'],
  '中部': ['新潟県','富山県','石川県','福井県','山梨県','長野県','岐阜県','静岡県','愛知県'],
  '近畿': ['三重県','滋賀県','京都府','大阪府','兵庫県','奈良県','和歌山県'],
  '中国': ['鳥取県','島根県','岡山県','広島県','山口県'],
  '四国': ['徳島県','香川県','愛媛県','高知県'],
  '九州': ['福岡県','佐賀県','長崎県','熊本県','大分県','宮崎県','鹿児島県'],
  '沖縄': ['沖縄県'],
};

// 都道府県別件数
const prefCounts: Record<string, number> = {};
for (const d of (destinations as any[])) {
  if (d.prefecture) prefCounts[d.prefecture] = (prefCounts[d.prefecture] || 0) + 1;
}
---

<DestinationLayout
  title="目的地一覧 | どこ行こ？"
  description="日本全国1163か所の旅先一覧。地域から探せます。"
>
<style>
  .list-hero {
    padding: 52px 24px 36px;
    text-align: center;
    border-bottom: 1px solid #ebebeb;
  }
  .list-hero-label {
    font-size: 10px; letter-spacing: 0.2em;
    color: #bbb; display: block; margin-bottom: 14px;
  }
  .list-hero-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 24px; font-weight: 400;
    color: #1a1a1a; letter-spacing: 0.06em;
  }
  .list-hero-count { font-size: 12px; color: #bbb; margin-top: 8px; }

  .list-content { max-width: 680px; margin: 0 auto; padding: 0 24px 80px; }

  .region-nav {
    display: flex; flex-wrap: wrap; gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 40px;
  }
  .region-nav-btn {
    padding: 5px 14px;
    border: 1px solid #e0e0e0;
    border-radius: 20px;
    font-size: 12px;
    color: #777;
    letter-spacing: 0.05em;
    transition: all 0.15s;
    cursor: pointer;
    background: none;
  }
  .region-nav-btn:hover,
  .region-nav-btn.is-active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  .region-block { margin-bottom: 52px; }
  .region-block[hidden] { display: none; }

  .region-block-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 17px; font-weight: 400;
    color: #1a1a1a; letter-spacing: 0.06em;
    padding-bottom: 12px;
    border-bottom: 1px solid #1a1a1a;
    margin-bottom: 4px;
  }

  .dest-list { display: flex; flex-direction: column; }
  .dest-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #f5f5f5;
    font-size: 14px;
    transition: background 0.1s;
  }
  .dest-item:hover { background: #fafafa; }
  .dest-item-left { display: flex; align-items: center; gap: 10px; }
  .dest-item-name { color: #1a1a1a; }
  .dest-item-tags { display: flex; gap: 4px; }
  .dest-item-tag {
    font-size: 10px; color: #bbb;
    border: 1px solid #f0f0f0;
    padding: 1px 7px; border-radius: 10px;
  }
  .dest-item-pref { font-size: 11px; color: #bbb; white-space: nowrap; }

  .empty-msg {
    display: none;
    text-align: center;
    padding: 60px 0;
    font-size: 14px;
    color: #aaa;
    letter-spacing: 0.05em;
  }
  .empty-msg.is-visible { display: block; }

  .pref-nav {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 8px 0 24px;
    margin-top: -16px;
    border-bottom: 1px solid #f0f0f0;
    margin-bottom: 32px;
  }
  .pref-nav[hidden] { display: none; }
  .pref-nav-label {
    width: 100%;
    font-size: 11px;
    color: #2A6049;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  .pref-nav-btn {
    padding: 5px 12px;
    border: 1px solid #d0e8da;
    border-radius: 16px;
    font-size: 12px;
    color: #2A6049;
    background: #f0faf4;
    cursor: pointer;
    transition: all 0.15s;
  }
  .pref-nav-btn:hover { background: #e0f3e8; }
  .pref-nav-btn.is-active { background: #2A6049; color: #fff; border-color: #2A6049; }
  .pref-nav-btn-count { font-size: 10px; opacity: 0.7; margin-left: 4px; }
  .dest-item[hidden] { display: none; }
</style>

  <div class="list-hero">
    <span class="list-hero-label">DESTINATIONS</span>
    <h1 class="list-hero-title">目的地一覧</h1>
    <p class="list-hero-count">全{(destinations as any[]).length}か所</p>
  </div>

  <div class="list-content">

    <nav class="region-nav">
      <button class="region-nav-btn" data-region="">すべて</button>
      {regions.map(r => (
        <button class="region-nav-btn" data-region={r}>{r}</button>
      ))}
    </nav>

    {regions.map(r => (
      <nav class="pref-nav" data-pref-nav-region={r} hidden>
        <span class="pref-nav-label">📍 {r}の都道府県</span>
        {(REGION_PREFS[r] || []).filter(p => prefCounts[p]).map(p => (
          <button class="pref-nav-btn" data-pref={p}>
            {p}<span class="pref-nav-btn-count">({prefCounts[p]})</span>
          </button>
        ))}
      </nav>
    ))}

    <p class="empty-msg" id="empty-msg">条件に一致する目的地がありません</p>

    {byRegion.map(({ region, items }) => (
      <div class="region-block" data-region={region} id={`region-${region}`}>
        <h2 class="region-block-title">{region}</h2>
        <div class="dest-list">
          {items.map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="dest-item" data-pref={d.prefecture}>
              <div class="dest-item-left">
                <span class="dest-item-name">{d.name}</span>
                <div class="dest-item-tags">
                  {d.tags?.slice(0, 2).map((tag: string) => (
                    <span class="dest-item-tag">{tag}</span>
                  ))}
                </div>
              </div>
              <span class="dest-item-pref">{d.prefecture} →</span>
            </a>
          ))}
        </div>
      </div>
    ))}

  </div>

<script>
  const params = new URLSearchParams(window.location.search);
  const regionParam = params.get('region') || '';
  const prefParam = params.get('prefecture') || '';

  const blocks = document.querySelectorAll<HTMLElement>('.region-block');
  const items = document.querySelectorAll<HTMLElement>('.dest-item');
  const regionBtns = document.querySelectorAll<HTMLButtonElement>('.region-nav-btn');
  const prefNavs = document.querySelectorAll<HTMLElement>('.pref-nav');
  const prefBtns = document.querySelectorAll<HTMLButtonElement>('.pref-nav-btn');
  const emptyMsg = document.getElementById('empty-msg')!;

  function applyFilter(region: string, pref: string) {
    // pref-nav表示: 該当地方のpref-navのみ表示
    prefNavs.forEach(nav => {
      nav.hidden = !region || nav.dataset.prefNavRegion !== region;
    });

    if (pref) {
      // 都道府県フィルター
      blocks.forEach(b => b.hidden = false);
      let visible = 0;
      items.forEach(it => {
        const match = it.dataset.pref === pref;
        it.hidden = !match;
        if (match) visible++;
      });
      blocks.forEach(b => {
        const visibleInBlock = b.querySelectorAll<HTMLElement>('.dest-item:not([hidden])').length;
        b.hidden = visibleInBlock === 0;
      });
      emptyMsg.classList.toggle('is-visible', visible === 0);
    } else {
      // 地方フィルター
      items.forEach(it => it.hidden = false);
      let visibleBlocks = 0;
      blocks.forEach(b => {
        const match = !region || b.dataset.region === region;
        b.hidden = !match;
        if (match) visibleBlocks++;
      });
      emptyMsg.classList.toggle('is-visible', visibleBlocks === 0);
    }

    regionBtns.forEach(btn => btn.classList.toggle('is-active', btn.dataset.region === region));
    prefBtns.forEach(btn => btn.classList.toggle('is-active', btn.dataset.pref === pref));

    const url = new URL(window.location.href);
    if (region) url.searchParams.set('region', region); else url.searchParams.delete('region');
    if (pref) url.searchParams.set('prefecture', pref); else url.searchParams.delete('prefecture');
    history.replaceState(null, '', url.toString());
  }

  // pref から region を逆算
  function regionOfPref(p: string): string {
    for (const nav of prefNavs) {
      if (nav.querySelector(`[data-pref="${p}"]`)) return nav.dataset.prefNavRegion || '';
    }
    return '';
  }

  // 初期状態
  let initRegion = regionParam;
  if (!initRegion && prefParam) initRegion = regionOfPref(prefParam);
  applyFilter(initRegion, prefParam);

  regionBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      applyFilter(btn.dataset.region || '', '');
    });
  });
  prefBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const pref = btn.dataset.pref || '';
      applyFilter(regionOfPref(pref), pref);
    });
  });
</script>

</DestinationLayout>
