---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

const { dest } = Astro.props;

const articlePath = path.join(process.cwd(), 'src/data/articles', `${dest.id}.json`);
const article = fs.existsSync(articlePath)
  ? JSON.parse(fs.readFileSync(articlePath, 'utf8'))
  : null;

const hasImage = fs.existsSync(path.join(process.cwd(), 'public/images', `${dest.id}.jpg`));
const imageUrl = hasImage ? `/images/${dest.id}.jpg` : null;

const seoTitle = `【${dest.name}】おすすめ観光スポット${dest.spots?.length || 3}選｜${dest.prefecture}の旅`;
const description = article?.lead?.slice(0, 120) || dest.description || `${dest.name}（${dest.prefecture}）への行き方・宿・観光スポット情報。`;

const CITY_NAMES: Record<string, string> = {
  tokyo: '東京', osaka: '大阪', nagoya: '名古屋', fukuoka: '福岡',
  takamatsu: '高松', sapporo: '札幌', sendai: '仙台', hiroshima: '広島',
  naha: '那覇', kanazawa: '金沢', gifu: '岐阜', mito: '水戸',
  maebashi: '前橋', takasaki: '高崎', hamamatsu: '浜松', kofu: '甲府',
  shingu: '新宮', tanabe: '田辺', shirahama: '白浜', kushimoto: '串本',
  tottori: '鳥取', shimonoseki: '下関', saga: '佐賀', oita: '大分', beppu: '別府',
};

const travelTimes = Object.entries(dest.travelTime || {})
  .filter(([_, v]) => v && v > 0)
  .sort(([, a], [, b]) => a - b)
  .slice(0, 5)
  .map(([city, min]) => ({
    city: CITY_NAMES[city] || city,
    min
  }));

const STEP_TYPE_LABEL: Record<string, string> = {
  rail: '鉄道', ferry: '船', flight: '航空', bus: 'バス', car: '車', local: '移動',
};

// 宿リンクを hotelSearch から構築（pre-built URL は古いデータが混在するため）
const hotelKeyword = (dest as any).hotelSearch || dest.name;
const rakutenHotelUrl =
  `https://hb.afl.rakuten.co.jp/hgc/5113ee4b.8662cfc5.5113ee4c.119de89a/?pc=` +
  encodeURIComponent(`https://travel.rakuten.co.jp/search/?keyword=${hotelKeyword}`);
const jalanHotelUrl =
  `https://ck.jp.ap.valuecommerce.com/servlet/referral?sid=3764408&pid=892559858&vc_url=` +
  encodeURIComponent(`https://www.jalan.net/uw/uwp2011/uww2011init.do?keyword=${encodeURIComponent(hotelKeyword)}`);

// 宿泊説明文（article に bestStay があれば優先、なければ destType で判定）
const STAY_DESC: Record<string, string> = {
  onsen:    '温泉旅館が中心。1泊2食プランがおすすめ。',
  city:     'ビジネスホテルから旅館まで幅広い選択肢。',
  island:   '宿数が少ないため早めの予約を。',
  mountain: '近隣の温泉地や市街地に宿が集まる。',
  sight:    '近隣の温泉地や市街地に宿が集まる。',
  remote:   '近隣の温泉地や市街地に宿が集まる。',
  peninsula:'近隣エリアに宿が集まる。',
};
const stayNote: string = article?.bestStay || STAY_DESC[(dest as any).destType] || '';
---

<DestinationLayout title={seoTitle} description={description} image={imageUrl}>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap');

  /* ── ヒーロー ── */
  .hero { position: relative; overflow: hidden; background: #e8e8e8; }
  .hero img { width: 100%; height: 300px; object-fit: cover; object-position: center; display: block; }

  /* ── コンテンツ幅 ── */
  .content { max-width: 660px; margin: 0 auto; padding: 0 24px 96px; }

  /* ── パンくず ── */
  .breadcrumb {
    padding: 16px 0 10px;
    font-size: 11px;
    color: #bbb;
    display: flex; gap: 6px; align-items: center;
    letter-spacing: 0.05em;
  }
  .breadcrumb a { color: #bbb; }

  /* ── タイトルエリア ── */
  .dest-header {
    padding: 24px 0 32px;
    border-bottom: 1px solid #e8e8e8;
    margin-bottom: 48px;
  }
  .dest-meta {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 12px;
  }
  .dest-pref {
    font-size: 11px; color: #bbb; letter-spacing: 0.12em; text-transform: uppercase;
  }
  .tier-badge {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 20px;
    font-size: 10px;
    letter-spacing: 0.08em;
    border: 1px solid #ddd;
    color: #aaa;
    background: #fafafa;
  }
  .dest-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 30px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    margin-bottom: 14px;
  }
  .dest-catch {
    font-size: 14px;
    color: #999;
    line-height: 1.8;
    font-style: italic;
    margin-bottom: 16px;
  }

  /* ── タグ ── */
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    padding: 3px 10px;
    border: 1px solid #e4e4e4;
    color: #999;
    font-size: 11px;
    border-radius: 20px;
    letter-spacing: 0.05em;
  }

  /* ── ICカードバッジ ── */
  .ic-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    letter-spacing: 0.05em;
    border: 1px solid #d8d8d8;
    color: #888;
    background: #f8f8f8;
    margin-bottom: 24px;
  }

  /* ── リード文 ── */
  .lead {
    font-size: 15px;
    line-height: 2.2;
    color: #333;
    margin-bottom: 56px;
    white-space: pre-line;
  }

  /* ── シーズン ── */
  .season-box {
    margin-bottom: 56px;
    padding: 24px 28px;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 14px;
    color: #555;
    line-height: 2;
  }
  .season-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #bbb;
    margin-bottom: 10px;
    display: block;
  }

  /* ── スポット ── */
  .spots-header { margin-bottom: 40px; }
  .spots-header h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    padding-bottom: 16px;
    border-bottom: 1px solid #1a1a1a;
  }
  .spot-section { margin-bottom: 56px; }
  .spot-num {
    font-size: 10px;
    letter-spacing: 0.18em;
    color: #bbb;
    margin-bottom: 4px;
  }
  .spot-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ebebeb;
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
  }
  .spot-body {
    font-size: 14px;
    line-height: 2.2;
    color: #444;
    margin-bottom: 24px;
  }
  .spot-body p { margin-bottom: 16px; }
  .spot-info {
    padding: 16px 20px;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 12px;
    color: #777;
    line-height: 2;
    white-space: pre-line;
    margin-bottom: 12px;
  }
  .spot-map {
    font-size: 12px;
    color: #aaa;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid #e4e4e4;
    padding-bottom: 2px;
  }

  /* ── モデルコース ── */
  .course-section { margin-bottom: 56px; }
  .course-section h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
    color: #1a1a1a;
  }
  .course-card {
    padding: 18px 22px;
    border-radius: 4px;
    margin-bottom: 10px;
    font-size: 13px;
    line-height: 2;
    color: #555;
  }
  .course-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    margin-bottom: 8px;
    display: block;
    font-weight: 500;
  }
  .course-daytrip { background: #fafaf5; border-left: 3px solid #c8b87a; }
  .course-daytrip .course-label { color: #8a7a4a; }
  .course-onenight { background: #f5f5fa; border-left: 3px solid #8a8ac8; }
  .course-onenight .course-label { color: #4a4a8a; }

  /* ── ヒント ── */
  .tips-box {
    margin-bottom: 56px;
    padding: 22px 26px;
    background: #f8faf8;
    border-left: 3px solid #a0c8a0;
    border-radius: 0 4px 4px 0;
    font-size: 14px;
    color: #444;
    line-height: 2.1;
  }
  .tips-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #7a9a7a;
    margin-bottom: 10px;
    display: block;
    font-weight: 500;
  }

  /* ── セパレーター ── */
  .section-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 56px 0;
  }

  /* ── 行き方 ── */
  .access-section { margin-bottom: 56px; }
  .section-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin-bottom: 28px;
    color: #1a1a1a;
  }
  .travel-times {
    background: #f8f8f8;
    border-radius: 4px;
    padding: 22px 26px;
    margin-bottom: 28px;
  }
  .travel-times-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    color: #bbb;
    margin-bottom: 16px;
    display: block;
  }
  .travel-time-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 11px 0;
    border-bottom: 1px solid #ebebeb;
    font-size: 13px;
  }
  .travel-time-row:last-child { border-bottom: none; }
  .travel-time-row span:first-child { color: #888; }
  .travel-time-row span:last-child { font-weight: 500; color: #1a1a1a; }

  .access-steps { display: flex; flex-direction: column; gap: 2px; }
  .access-step {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 4px;
    font-size: 13px;
    color: #444;
  }
  .step-type {
    font-size: 10px;
    padding: 2px 7px;
    border-radius: 3px;
    background: #f0f0f0;
    color: #888;
    letter-spacing: 0.05em;
    white-space: nowrap;
    min-width: 32px;
    text-align: center;
  }
  .step-arrow { text-align: center; color: #ddd; font-size: 11px; padding: 2px 0; }

  /* ── 宿泊 ── */
  .hotel-section { margin-bottom: 56px; }
  .hotel-description {
    font-size: 14px;
    color: #888;
    margin-bottom: 20px;
    line-height: 2;
  }
  .hotel-cards { display: flex; flex-direction: column; gap: 10px; }
  .hotel-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .hotel-card:hover { border-color: #bbb; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .hotel-card-name {
    font-size: 14px;
    font-weight: 500;
    color: #1a1a1a;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .hotel-card-desc { font-size: 12px; color: #bbb; }
  .hotel-card-arrow { font-size: 14px; color: #ccc; }

  /* ── 近くの旅先 ── */
  .nearby-section { margin-bottom: 56px; }
  .nearby-list { display: flex; flex-direction: column; }
  .nearby-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 17px 0;
    border-bottom: 1px solid #ebebeb;
    font-size: 14px;
  }
  .nearby-item:first-child { border-top: 1px solid #ebebeb; }
  .nearby-name { color: #1a1a1a; }
  .nearby-pref { color: #bbb; font-size: 11px; }

  /* ── CTA ── */
  .cta-section {
    padding: 48px 24px;
    background: #f8f8f8;
    border-radius: 4px;
    text-align: center;
    margin-bottom: 56px;
  }
  .cta-label { font-size: 10px; letter-spacing: 0.16em; color: #bbb; margin-bottom: 10px; display: block; }
  .cta-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 19px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 28px;
    letter-spacing: 0.05em;
  }
  .cta-btn {
    display: inline-block;
    padding: 15px 40px;
    background: #1a1a1a;
    color: #fff;
    border-radius: 2px;
    font-size: 13px;
    letter-spacing: 0.12em;
    transition: opacity 0.2s;
  }
  .cta-btn:hover { opacity: 0.8; }
</style>

  <!-- ヒーロー画像（存在する場合のみ） -->
  {imageUrl && (
    <div class="hero">
      <img src={imageUrl} alt={`${dest.name}の風景`} />
    </div>
  )}

  <div class="content">

    <!-- パンくず -->
    <nav class="breadcrumb">
      <a href="/">HOME</a> ›
      <a href="/destinations/">{dest.region || dest.prefecture}</a> ›
      <span>{dest.name}</span>
    </nav>

    <!-- タイトルエリア -->
    <div class="dest-header">
      <div class="dest-meta">
        <p class="dest-pref">{dest.prefecture}</p>
        <span class="tier-badge">
          {(dest as any).tier === 'area' ? '滞在型' : '訪問スポット'}
        </span>
      </div>
      <h1 class="dest-title">{dest.name}</h1>
      {(dest as any).catch && <p class="dest-catch">{(dest as any).catch}</p>}
      <div class="tags">
        {dest.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    <!-- リード文 -->
    {article?.lead && <p class="lead">{article.lead}</p>}

    <!-- おすすめシーズン -->
    {article?.bestSeason && (
      <div class="season-box">
        <span class="season-label">BEST SEASON</span>
        {article.bestSeason}
      </div>
    )}

    <!-- スポット -->
    {article?.sections && article.sections.length > 0 && (
      <div>
        <div class="spots-header">
          <h2>{dest.name}のおすすめスポット</h2>
        </div>
        {article.sections.map((section: any, i: number) => (
          <div class="spot-section">
            <p class="spot-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="spot-title">{section.title || section.heading}</h3>
            <div class="spot-body">
              {section.body.split('\n').map((p: string) => p.trim()).filter(Boolean).map((p: string) => (
                <p>{p}</p>
              ))}
            </div>
            {section.info && <div class="spot-info">{section.info}</div>}
            <a
              href={`https://www.google.com/maps/search/${encodeURIComponent((section.title || section.heading || '') + ' ' + dest.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="spot-map"
            >地図で見る →</a>
          </div>
        ))}
      </div>
    )}

    <!-- モデルコース -->
    {article?.modelCourse && (
      <div class="course-section">
        <h2>モデルコース</h2>
        {article.modelCourse.daytrip && (
          <div class="course-card course-daytrip">
            <span class="course-label">DAY TRIP</span>
            {article.modelCourse.daytrip}
          </div>
        )}
        {article.modelCourse.onenight && (
          <div class="course-card course-onenight">
            <span class="course-label">1 NIGHT</span>
            {article.modelCourse.onenight}
          </div>
        )}
      </div>
    )}

    <!-- 旅のヒント -->
    {article?.tips && (
      <div class="tips-box">
        <span class="tips-label">TRAVEL TIPS</span>
        {typeof article.tips === 'string' ? article.tips : article.tips.join('\n')}
      </div>
    )}

    <hr class="section-divider" />

    <!-- 行き方 -->
    <div class="access-section">
      <h2 class="section-title">{dest.name}への行き方</h2>
      {(dest as any).icCard && (
        <div class="ic-badge">ICカード利用可</div>
      )}
      {travelTimes.length > 0 && (
        <div class="travel-times">
          <span class="travel-times-label">ACCESS TIME</span>
          {travelTimes.map(({ city, min }: { city: string; min: number }) => (
            <div class="travel-time-row">
              <span>{city}から</span>
              <span>{min >= 60 ? `約${Math.floor(min/60)}時間${min%60 > 0 ? min%60 + '分' : ''}` : `約${min}分`}</span>
            </div>
          ))}
        </div>
      )}
      {dest.access?.steps && dest.access.steps.length > 0 ? (
        <div class="access-steps">
          {dest.access.steps.map((step: any, i: number) => (
            <>
              <div class="access-step">
                <span class="step-type">{STEP_TYPE_LABEL[step.type] || '移動'}</span>
                <span>{(step.to || step.from) + 'へ'}</span>
              </div>
              {i < dest.access.steps.length - 1 && <div class="step-arrow">↓</div>}
            </>
          ))}
        </div>
      ) : (
        <div class="access-steps">
          {(dest as any).gateways?.rail?.length > 0 && (
            <div class="access-step">
              <span class="step-type">鉄道</span>
              <span>{(dest as any).gateways.rail.join(' / ')}</span>
            </div>
          )}
          {(dest as any).gateways?.airport?.length > 0 && (
            <>
              {(dest as any).gateways?.rail?.length > 0 && <div class="step-arrow">↓</div>}
              <div class="access-step">
                <span class="step-type">航空</span>
                <span>{(dest as any).gateways.airport.join(' / ')}</span>
              </div>
            </>
          )}
          {(dest as any).gateways?.ferry?.length > 0 && (
            <div class="access-step">
              <span class="step-type">船</span>
              <span>{(dest as any).gateways.ferry.join(' / ')}</span>
            </div>
          )}
          {(dest as any).railNote && (
            <div class="access-step" style="background: #f8f8f8; border-color: #e0e0e0;">
              <span class="step-type">備考</span>
              <span style="font-size: 12px; color: #777;">{(dest as any).railNote}</span>
            </div>
          )}
        </div>
      )}
    </div>

    <hr class="section-divider" />

    <!-- 宿泊 -->
    <div class="hotel-section">
      <h2 class="section-title">{hotelKeyword}の宿を探す</h2>
      {stayNote && <p class="hotel-description">{stayNote}</p>}
      <div class="hotel-cards">
        <a href={rakutenHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card">
          <div>
            <p class="hotel-card-name">楽天トラベル</p>
            <p class="hotel-card-desc">ポイントが貯まる・使える</p>
          </div>
          <span class="hotel-card-arrow">→</span>
        </a>
        <a href={jalanHotelUrl} target="_blank" rel="noopener noreferrer" class="hotel-card">
          <div>
            <p class="hotel-card-name">じゃらん</p>
            <p class="hotel-card-desc">国内旅行・宿泊予約</p>
          </div>
          <span class="hotel-card-arrow">→</span>
        </a>
      </div>
    </div>

    <hr class="section-divider" />

    <!-- 近くの旅先 -->
    <div class="nearby-section">
      <h2 class="section-title">近くの旅先</h2>
      <div class="nearby-list">
        {(destinations as any[])
          .filter((d: any) => d.id !== dest.id && d.region === dest.region)
          .slice(0, 5)
          .map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-item">
              <span class="nearby-name">{d.name}</span>
              <span class="nearby-pref">{d.prefecture} →</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <span class="cta-label">TRAVEL PLANNING</span>
      <p class="cta-title">旅先を1分で決めてみる？</p>
      <a href="/" class="cta-btn">どこ行こ？で旅先を探す →</a>
    </div>

  </div>
</DestinationLayout>
