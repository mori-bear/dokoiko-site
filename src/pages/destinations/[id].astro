---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

const { dest } = Astro.props;

const articlePath = path.join(process.cwd(), 'src/data/articles', `${dest.id}.json`);
const article = fs.existsSync(articlePath)
  ? JSON.parse(fs.readFileSync(articlePath, 'utf8'))
  : null;

const hasImage = fs.existsSync(path.join(process.cwd(), 'public/images', `${dest.id}.jpg`));
const imageUrl = hasImage ? `/images/${dest.id}.jpg` : null;

const title = `【${dest.name}】おすすめ観光スポット${dest.spots?.length || 3}選｜${dest.prefecture}の旅`;
const description = article?.lead?.slice(0, 120) || dest.description || `${dest.name}（${dest.prefecture}）への行き方・宿・観光スポット情報。`;

const travelTimes = Object.entries(dest.travelTime || {})
  .filter(([_, v]) => v && v > 0)
  .sort(([, a], [, b]) => a - b)
  .slice(0, 4)
  .map(([city, min]) => ({
    city: { tokyo: '東京', osaka: '大阪', nagoya: '名古屋', fukuoka: '福岡', takamatsu: '高松', sapporo: '札幌', sendai: '仙台', hiroshima: '広島', naha: '那覇', kanazawa: '金沢' }[city] || city,
    min
  }));

const regionColors: Record<string, string> = {
  '北海道': 'linear-gradient(135deg, #e0f2fe, #bae6fd)',
  '東北': 'linear-gradient(135deg, #dcfce7, #bbf7d0)',
  '関東': 'linear-gradient(135deg, #fef9c3, #fef08a)',
  '中部': 'linear-gradient(135deg, #ffedd5, #fed7aa)',
  '近畿': 'linear-gradient(135deg, #fce7f3, #fbcfe8)',
  '中国': 'linear-gradient(135deg, #f3e8ff, #e9d5ff)',
  '四国': 'linear-gradient(135deg, #ecfdf5, #a7f3d0)',
  '九州': 'linear-gradient(135deg, #fff7ed, #fed7aa)',
  '沖縄': 'linear-gradient(135deg, #e0f2fe, #7dd3fc)',
};
const regionColor = regionColors[dest.region] || 'linear-gradient(135deg, #f5f5f5, #e5e5e5)';

const regionEmojis: Record<string, string> = {
  '北海道': '🦊', '東北': '⛩️', '関東': '🗼', '中部': '🏔️',
  '近畿': '🦌', '中国': '⛩️', '四国': '🍊', '九州': '🌋', '沖縄': '🌺',
};
const emoji = regionEmojis[dest.region] || '🗾';
---

<DestinationLayout title={title} description={description} image={imageUrl}>
<style>
  /* ヒーロー */
  .hero { position: relative; background: #f5f5f5; }
  .hero img { width: 100%; height: 280px; object-fit: cover; }
  .hero-placeholder {
    width: 100%; height: 200px;
    background: linear-gradient(135deg, #e8f4f8, #d4edf5);
    display: flex; align-items: center; justify-content: center;
    font-size: 48px;
  }

  /* コンテンツ */
  .content { max-width: 680px; margin: 0 auto; padding: 0 20px; }

  /* パンくず */
  .breadcrumb {
    padding: 12px 0;
    font-size: 12px;
    color: #999;
    display: flex; gap: 4px; align-items: center;
  }
  .breadcrumb a { color: #999; }
  .breadcrumb span { color: #ccc; }

  /* タイトル */
  .dest-title {
    font-size: 24px;
    font-weight: bold;
    line-height: 1.4;
    margin: 8px 0 4px;
  }
  .dest-pref { font-size: 13px; color: #999; margin-bottom: 16px; }

  /* タグ */
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 24px; }
  .tag {
    padding: 4px 10px;
    background: #f5f5f5;
    color: #666;
    font-size: 12px;
    border-radius: 20px;
  }

  /* リード文 */
  .lead {
    font-size: 15px;
    line-height: 2;
    color: #444;
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid #eee;
  }

  /* シーズン */
  .season-box {
    margin-bottom: 32px;
    padding: 16px;
    background: #f0f7ff;
    border-left: 4px solid #93c5fd;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    color: #444;
  }
  .season-box strong { display: block; color: #3b82f6; margin-bottom: 4px; font-size: 13px; }

  /* スポット見出し */
  .spots-title {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 32px;
    padding-bottom: 12px;
    border-bottom: 2px solid #333;
  }

  /* スポットセクション */
  .spot-section { margin-bottom: 48px; }
  .spot-num { font-size: 12px; color: #999; margin-bottom: 4px; }
  .spot-title {
    font-size: 18px;
    font-weight: bold;
    line-height: 1.4;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee;
  }
  .spot-image {
    width: 100%; height: 220px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 16px;
  }
  .spot-body {
    font-size: 14px;
    line-height: 2;
    color: #444;
    margin-bottom: 16px;
    white-space: pre-line;
  }
  .spot-info {
    padding: 12px 16px;
    background: #f9f9f9;
    border-radius: 8px;
    font-size: 12px;
    color: #666;
    line-height: 1.8;
    white-space: pre-line;
    margin-bottom: 8px;
  }
  .spot-map {
    font-size: 13px;
    color: #3b82f6;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* モデルコース */
  .course-section { margin-bottom: 40px; }
  .course-title { font-size: 20px; font-weight: bold; margin-bottom: 20px; }
  .course-card {
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 12px;
    font-size: 14px;
    line-height: 1.8;
    color: #444;
  }
  .course-card strong { display: block; margin-bottom: 8px; font-size: 13px; }
  .course-daytrip { background: #fffbeb; border: 1px solid #fde68a; }
  .course-daytrip strong { color: #d97706; }
  .course-onenight { background: #eef2ff; border: 1px solid #c7d2fe; }
  .course-onenight strong { color: #4f46e5; }

  /* ヒント */
  .tips-box {
    margin-bottom: 40px;
    padding: 16px;
    background: #f0fdf4;
    border-left: 4px solid #86efac;
    border-radius: 0 8px 8px 0;
    font-size: 14px;
    color: #444;
    line-height: 1.8;
  }
  .tips-box strong { display: block; color: #16a34a; margin-bottom: 8px; font-size: 13px; }

  /* セパレーター */
  .section-divider { border: none; border-top: 1px solid #eee; margin: 40px 0; }

  /* 行き方 */
  .access-section { margin-bottom: 40px; }
  .section-title { font-size: 20px; font-weight: bold; margin-bottom: 20px; }
  .travel-times {
    background: #f9f9f9;
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 20px;
  }
  .travel-times p { font-size: 13px; color: #999; margin-bottom: 12px; }
  .travel-time-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid #eee;
    font-size: 14px;
  }
  .travel-time-row:last-child { border-bottom: none; }
  .travel-time-row span:first-child { color: #666; }
  .travel-time-row span:last-child { font-weight: bold; }

  /* アクセスステップ */
  .access-steps { display: flex; flex-direction: column; gap: 4px; }
  .access-step {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
  }
  .access-step-icon { font-size: 20px; min-width: 28px; text-align: center; }
  .step-arrow { text-align: center; color: #d1d5db; font-size: 12px; padding: 2px 0; }

  /* 宿泊 */
  .hotel-section { margin-bottom: 40px; }
  .hotel-description { font-size: 14px; color: #666; margin-bottom: 16px; line-height: 1.8; }
  .hotel-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .btn-rakuten {
    display: block; padding: 16px;
    background: #c0392b; color: #fff;
    text-align: center; border-radius: 10px;
    font-weight: bold; font-size: 14px;
    transition: opacity 0.2s;
  }
  .btn-rakuten:hover { opacity: 0.9; }
  .btn-jalan {
    display: block; padding: 16px;
    background: #e67e22; color: #fff;
    text-align: center; border-radius: 10px;
    font-weight: bold; font-size: 14px;
    transition: opacity 0.2s;
  }
  .btn-jalan:hover { opacity: 0.9; }

  /* 近くの旅先 */
  .nearby-section { margin-bottom: 40px; }
  .nearby-list { display: flex; flex-direction: column; gap: 8px; }
  .nearby-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 16px;
    background: #f9f9f9;
    border-radius: 10px;
    font-size: 14px;
    transition: background 0.2s;
  }
  .nearby-item:hover { background: #f0f0f0; }
  .nearby-item span:last-child { color: #999; font-size: 12px; }

  /* CTA */
  .cta-section {
    padding: 32px 24px;
    background: #f0f9ff;
    border-radius: 16px;
    text-align: center;
    margin-bottom: 40px;
  }
  .cta-section p { font-size: 13px; color: #999; margin-bottom: 4px; }
  .cta-section strong { display: block; font-size: 16px; color: #333; margin-bottom: 16px; }
  .cta-btn {
    display: inline-block;
    padding: 14px 32px;
    background: #2563eb;
    color: #fff;
    border-radius: 999px;
    font-weight: bold;
    font-size: 15px;
    transition: opacity 0.2s;
  }
  .cta-btn:hover { opacity: 0.9; }
</style>

  <!-- ヒーロー画像 -->
  <div class="hero">
    {imageUrl ? (
      <img src={imageUrl} alt={`${dest.name}の風景`} />
    ) : (
      <div class="hero-placeholder" style={`background: ${regionColor};`}>
        <div style="text-align: center;">
          <div style="font-size: 48px;">{emoji}</div>
          <div style="font-size: 14px; color: #666; margin-top: 8px;">{dest.name}</div>
        </div>
      </div>
    )}
  </div>

  <div class="content">

    <!-- パンくず -->
    <nav class="breadcrumb">
      <a href="/">HOME</a>
      <span>›</span>
      <a href="/destinations/">{dest.region || dest.prefecture}</a>
      <span>›</span>
      <span>{dest.name}</span>
    </nav>

    <!-- タイトル -->
    <h1 class="dest-title">{title}</h1>
    <p class="dest-pref">{dest.prefecture}</p>

    <!-- タグ -->
    <div class="tags">
      {dest.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>

    <!-- リード文 -->
    {article?.lead && <p class="lead">{article.lead}</p>}

    <!-- おすすめシーズン -->
    {article?.bestSeason && (
      <div class="season-box">
        <strong>🌸 おすすめの季節</strong>
        {article.bestSeason}
      </div>
    )}

    <!-- スポット -->
    {article?.sections && article.sections.length > 0 && (
      <div>
        <h2 class="spots-title">{dest.name}のおすすめスポット</h2>
        {article.sections.map((section: any, i: number) => (
          <div class="spot-section">
            <p class="spot-num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="spot-title">{section.title || section.heading}</h3>
            {imageUrl && i === 0 && (
              <img src={imageUrl} alt={section.imageAlt || dest.name} class="spot-image" />
            )}
            <p class="spot-body">{section.body}</p>
            {section.info && <div class="spot-info">{section.info}</div>}
            <a
              href={`https://www.google.com/maps/search/${encodeURIComponent((section.title || section.heading || '') + ' ' + dest.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="spot-map"
            >📍 地図で見る →</a>
          </div>
        ))}
      </div>
    )}

    <!-- モデルコース -->
    {article?.modelCourse && (
      <div class="course-section">
        <h2 class="course-title">モデルコース</h2>
        {article.modelCourse.daytrip && (
          <div class="course-card course-daytrip">
            <strong>☀️ 日帰りプラン</strong>
            {article.modelCourse.daytrip}
          </div>
        )}
        {article.modelCourse.onenight && (
          <div class="course-card course-onenight">
            <strong>🌙 1泊2日プラン</strong>
            {article.modelCourse.onenight}
          </div>
        )}
      </div>
    )}

    <!-- 旅のヒント -->
    {article?.tips && (
      <div class="tips-box">
        <strong>💡 旅のヒント</strong>
        {typeof article.tips === 'string' ? article.tips : article.tips.join('\n')}
      </div>
    )}

    <hr class="section-divider" />

    <!-- 行き方 -->
    <div class="access-section">
      <h2 class="section-title">🗺️ {dest.name}への行き方</h2>

      {travelTimes.length > 0 && (
        <div class="travel-times">
          <p>主要都市からの所要時間</p>
          {travelTimes.map(({ city, min }: { city: string; min: number }) => (
            <div class="travel-time-row">
              <span>{city}から</span>
              <span>{min >= 60 ? `約${Math.floor(min/60)}時間${min%60 > 0 ? min%60 + '分' : ''}` : `約${min}分`}</span>
            </div>
          ))}
        </div>
      )}

      {dest.access?.steps && dest.access.steps.length > 0 && (
        <div class="access-steps">
          {dest.access.steps.map((step: any, i: number) => (
            <>
              <div class="access-step">
                <span class="access-step-icon">
                  {step.type === 'rail' ? '🚃' : step.type === 'ferry' ? '⛴️' : step.type === 'flight' ? '✈️' : step.type === 'bus' ? '🚌' : step.type === 'car' ? '🚗' : '🚶'}
                </span>
                <span>{(step.to || step.from) + 'へ'}</span>
              </div>
              {i < dest.access.steps.length - 1 && <div class="step-arrow">↓</div>}
            </>
          ))}
        </div>
      )}
    </div>

    <hr class="section-divider" />

    <!-- 宿泊 -->
    {(dest.hotelLinks?.rakuten || dest.hotelLinks?.jalan) && (
      <div class="hotel-section">
        <h2 class="section-title">{dest.name}で泊まる</h2>
        <p class="hotel-description">
          {dest.stayAllowed?.includes('1night') ? `せっかく${dest.name}まで来たなら、1泊してゆっくり楽しみましょう。` : `${dest.name}周辺の宿泊施設を探してみましょう。`}
        </p>
        <div class="hotel-buttons">
          {dest.hotelLinks?.rakuten && (
            <a href={dest.hotelLinks.rakuten} target="_blank" rel="noopener noreferrer" class="btn-rakuten">楽天で宿を見る</a>
          )}
          {dest.hotelLinks?.jalan && (
            <a href={dest.hotelLinks.jalan} target="_blank" rel="noopener noreferrer" class="btn-jalan">じゃらんで宿を見る</a>
          )}
        </div>
      </div>
    )}

    <hr class="section-divider" />

    <!-- 近くの旅先 -->
    <div class="nearby-section">
      <h2 class="section-title">近くの旅先</h2>
      <div class="nearby-list">
        {(destinations as any[])
          .filter((d: any) => d.id !== dest.id && d.region === dest.region)
          .slice(0, 5)
          .map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-item">
              <span>{d.name}</span>
              <span>{d.prefecture} →</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <p>行き先がまだ決まっていない人へ</p>
      <strong>旅先を1分で決めてみる？</strong>
      <a href="https://tabidokoiko.com" class="cta-btn">どこ行こ？で旅先を探す →</a>
    </div>

  </div>
</DestinationLayout>
