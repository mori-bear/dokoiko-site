---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return (destinations as any[]).map((dest: any) => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

const { dest } = Astro.props as { dest: any };

const articlePath = path.join(process.cwd(), 'src/data/articles', `${dest.id}.json`);
const article = fs.existsSync(articlePath)
  ? JSON.parse(fs.readFileSync(articlePath, 'utf8'))
  : null;

const hasImage = fs.existsSync(path.join(process.cwd(), 'public/images', `${dest.id}.jpg`));

const title = `【${dest.name}】おすすめ観光スポット${dest.spots?.length || 3}選 | ${dest.catch || dest.name + 'への旅'}`;
const description = article?.lead?.slice(0, 120) || dest.description || `${dest.name}への行き方・宿・観光スポット情報。`;

const cityNames: Record<string, string> = {
  tokyo: '東京', osaka: '大阪', nagoya: '名古屋', fukuoka: '福岡',
  takamatsu: '高松', sapporo: '札幌', sendai: '仙台', hiroshima: '広島',
  naha: '那覇', kanazawa: '金沢'
};
const travelTimes = Object.entries(dest.travelTime || {})
  .filter(([_, v]: [string, any]) => v && v > 0)
  .sort(([, a]: [string, any], [, b]: [string, any]) => a - b)
  .slice(0, 4)
  .map(([city, min]: [string, any]) => ({ city: cityNames[city] || city, min }));

const accessStepIcon: Record<string, string> = {
  rail: '🚃', ferry: '⛴', flight: '✈️', bus: '🚌', car: '🚗', local: '🚶'
};
---

<DestinationLayout title={title} description={description}>

  <!-- ヒーロー -->
  {hasImage ? (
    <img
      src={`/images/${dest.id}.jpg`}
      alt={`${dest.name}の風景`}
      class="w-full h-72 object-cover"
    />
  ) : (
    <div class="w-full h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center">
      <span class="text-5xl">🗾</span>
    </div>
  )}

  <div class="max-w-2xl mx-auto px-4 py-6">

    <!-- パンくず -->
    <nav class="text-xs text-gray-400 mb-4">
      <a href="/" class="hover:underline">HOME</a>
      <span class="mx-1">›</span>
      <span>{dest.region || dest.prefecture}</span>
      <span class="mx-1">›</span>
      <span>{dest.name}</span>
    </nav>

    <!-- タイトル・都道府県 -->
    <h1 class="text-2xl font-bold leading-tight mb-1">{title}</h1>
    <p class="text-xs text-gray-400 mb-4">{dest.prefecture}</p>

    <!-- タグ -->
    {dest.tags?.length > 0 && (
      <div class="flex flex-wrap gap-1 mb-6">
        {dest.tags.map((tag: string) => (
          <span class="px-2 py-1 bg-gray-100 text-gray-500 text-xs rounded-full">{tag}</span>
        ))}
      </div>
    )}

    <!-- リード文 -->
    {article?.lead && (
      <p class="text-gray-700 leading-relaxed text-base mb-8">{article.lead}</p>
    )}

    <!-- おすすめシーズン -->
    {article?.bestSeason && (
      <div class="mb-8 p-4 bg-blue-50 rounded-lg border-l-4 border-blue-300">
        <p class="text-sm font-bold text-blue-700 mb-1">🌸 おすすめの季節</p>
        <p class="text-sm text-blue-600">{article.bestSeason}</p>
      </div>
    )}

    <!-- スポット記事 -->
    {article?.sections ? (
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-6 pb-2 border-b-2 border-gray-200">
          {dest.name}のおすすめスポット
        </h2>
        {article.sections.map((section: any, i: number) => (
          <div class="mb-10">
            <h3 class="text-lg font-bold mb-3">
              <span class="text-blue-400 mr-2">{String(i + 1).padStart(2, '0')}</span>
              {section.title || section.heading}
            </h3>
            {hasImage && i === 0 && (
              <img
                src={`/images/${dest.id}.jpg`}
                alt={section.imageAlt || dest.name}
                class="w-full h-52 object-cover rounded-lg mb-4"
              />
            )}
            <p class="text-gray-700 leading-relaxed text-sm whitespace-pre-line mb-3">
              {section.body}
            </p>
            {section.info && (
              <div class="p-3 bg-gray-50 rounded text-xs text-gray-500 whitespace-pre-line">
                {section.info}
              </div>
            )}
            <a
              href={`https://www.google.com/maps/search/${encodeURIComponent((section.title || section.heading || '') + ' ' + dest.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-2 text-blue-500 text-xs"
            >
              📍 地図で見る →
            </a>
          </div>
        ))}
      </div>
    ) : (
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4">代表スポット</h2>
        <div class="space-y-2">
          {dest.spots?.map((spot: string) => (
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
              <span class="text-sm font-medium">{spot}</span>
              <a
                href={`https://www.google.com/maps/search/${encodeURIComponent(spot + ' ' + dest.name)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-500 text-xs"
              >地図 →</a>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- モデルコース -->
    {article?.modelCourse && (
      <div class="mb-8">
        <h2 class="text-xl font-bold mb-4">モデルコース</h2>
        {dest.stayAllowed?.includes('daytrip') && article.modelCourse.daytrip && (
          <div class="mb-4 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
            <p class="text-sm font-bold text-yellow-700 mb-2">☀️ 日帰りプラン</p>
            <p class="text-sm text-gray-600 leading-relaxed">{article.modelCourse.daytrip}</p>
          </div>
        )}
        {dest.stayAllowed?.includes('1night') && article.modelCourse.onenight && (
          <div class="p-4 bg-indigo-50 rounded-lg border border-indigo-200">
            <p class="text-sm font-bold text-indigo-700 mb-2">🌙 1泊2日プラン</p>
            <p class="text-sm text-gray-600 leading-relaxed">{article.modelCourse.onenight}</p>
          </div>
        )}
      </div>
    )}

    <!-- 旅のヒント -->
    {article?.tips && (
      <div class="mb-8 p-4 bg-green-50 rounded-lg border-l-4 border-green-300">
        <p class="text-sm font-bold text-green-700 mb-2">💡 旅のヒント</p>
        <p class="text-sm text-gray-600 leading-relaxed">
          {typeof article.tips === 'string' ? article.tips : article.tips.join('\n')}
        </p>
      </div>
    )}

    <hr class="my-8 border-gray-200" />

    <!-- 行き方 -->
    <div class="mb-8">
      <h2 class="text-xl font-bold mb-4">🗺️ {dest.name}への行き方</h2>

      {travelTimes.length > 0 && (
        <div class="mb-4 p-4 bg-gray-50 rounded-lg">
          <p class="text-sm font-bold text-gray-600 mb-3">主要都市からの所要時間</p>
          <div class="space-y-2">
            {travelTimes.map(({ city, min }: { city: string; min: number }) => (
              <div class="flex justify-between text-sm">
                <span class="text-gray-500">{city}から</span>
                <span class="font-bold">
                  {min >= 60 ? `約${Math.floor(min / 60)}時間${min % 60 > 0 ? min % 60 + '分' : ''}` : `約${min}分`}
                </span>
              </div>
            ))}
          </div>
        </div>
      )}

      {dest.access?.steps && dest.access.steps.length > 0 && (
        <div class="space-y-1">
          {dest.access.steps.map((step: any, i: number) => (
            <div>
              <div class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg">
                <span class="text-xl">{accessStepIcon[step.type] || '🚶'}</span>
                <span class="text-sm">{step.to || step.from}へ</span>
              </div>
              {i < dest.access.steps.length - 1 && (
                <div class="text-center text-gray-300 text-xs py-1">↓</div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>

    <hr class="my-8 border-gray-200" />

    <!-- 宿泊 -->
    <div class="mb-8">
      <h2 class="text-xl font-bold mb-2">{dest.name}で泊まる</h2>
      {dest.stayDescription && (
        <p class="text-sm text-gray-500 mb-4">{dest.stayDescription}</p>
      )}
      <div class="grid grid-cols-2 gap-3">
        {dest.hotelLinks?.rakuten && (
          <a
            href={dest.hotelLinks.rakuten}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-red-500 text-white text-sm font-bold py-3 px-4 rounded-lg hover:bg-red-600 transition-colors"
          >
            楽天トラベル
          </a>
        )}
        {dest.hotelLinks?.jalan && (
          <a
            href={dest.hotelLinks.jalan}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-orange-400 text-white text-sm font-bold py-3 px-4 rounded-lg hover:bg-orange-500 transition-colors"
          >
            じゃらん
          </a>
        )}
      </div>
      <p class="text-xs text-gray-300 mt-2">※アフィリエイト広告を含みます</p>
    </div>

    <hr class="my-8 border-gray-200" />

    <!-- どこ行こ？CTA -->
    <div class="mb-10 p-6 bg-gradient-to-br from-blue-600 to-teal-500 rounded-2xl text-white text-center">
      <p class="text-lg font-bold mb-1">{dest.name}への旅を計画する</p>
      <p class="text-sm text-white/80 mb-5">
        出発地を選ぶだけ。行き方・宿・所要時間をまとめて確認できます。
      </p>
      <a
        href={`https://tabidokoiko.com/?dest=${encodeURIComponent(dest.id)}`}
        class="inline-block bg-white text-blue-600 font-bold px-8 py-3 rounded-xl hover:bg-blue-50 transition-colors"
      >
        どこ行こ？で旅を計画 →
      </a>
    </div>

    <!-- ナビゲーション -->
    <div class="text-center">
      <a href="/destinations" class="text-sm text-blue-500 hover:underline">
        ← 目的地一覧へ戻る
      </a>
    </div>

  </div>

</DestinationLayout>
