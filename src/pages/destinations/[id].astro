---
import DestinationLayout from '../../layouts/DestinationLayout.astro';
import destinations from '../../data/destinations.json';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  return destinations.map(dest => ({
    params: { id: dest.id },
    props: { dest }
  }));
}

const { dest } = Astro.props;

const articlePath = path.join(process.cwd(), 'src/data/articles', `${dest.id}.json`);
const article = fs.existsSync(articlePath)
  ? JSON.parse(fs.readFileSync(articlePath, 'utf8'))
  : null;

const hasImage = fs.existsSync(path.join(process.cwd(), 'public/images', `${dest.id}.jpg`));
const imageUrl = hasImage ? `/images/${dest.id}.jpg` : null;

const title = `【${dest.name}】おすすめ観光スポット${dest.spots?.length || 3}選｜${dest.prefecture}の旅`;
const description = article?.lead?.slice(0, 120) || dest.description || `${dest.name}（${dest.prefecture}）への行き方・宿・観光スポット情報。`;

const travelTimes = Object.entries(dest.travelTime || {})
  .filter(([_, v]) => v && v > 0)
  .sort(([, a], [, b]) => a - b)
  .slice(0, 4)
  .map(([city, min]) => ({
    city: { tokyo: '東京', osaka: '大阪', nagoya: '名古屋', fukuoka: '福岡', takamatsu: '高松', sapporo: '札幌', sendai: '仙台', hiroshima: '広島', naha: '那覇', kanazawa: '金沢' }[city] || city,
    min
  }));

const regionColors: Record<string, string> = {
  '北海道': 'linear-gradient(135deg, #e0f2fe, #bae6fd)',
  '東北': 'linear-gradient(135deg, #dcfce7, #bbf7d0)',
  '関東': 'linear-gradient(135deg, #fef9c3, #fef08a)',
  '中部': 'linear-gradient(135deg, #ffedd5, #fed7aa)',
  '近畿': 'linear-gradient(135deg, #fce7f3, #fbcfe8)',
  '中国': 'linear-gradient(135deg, #f3e8ff, #e9d5ff)',
  '四国': 'linear-gradient(135deg, #ecfdf5, #a7f3d0)',
  '九州': 'linear-gradient(135deg, #fff7ed, #fed7aa)',
  '沖縄': 'linear-gradient(135deg, #e0f2fe, #7dd3fc)',
};
const regionColor = regionColors[dest.region] || 'linear-gradient(135deg, #f5f5f5, #e5e5e5)';

const regionEmojis: Record<string, string> = {
  '北海道': '🦊', '東北': '⛩️', '関東': '🗼', '中部': '🏔️',
  '近畿': '🦌', '中国': '⛩️', '四国': '🍊', '九州': '🌋', '沖縄': '🌺',
};
const emoji = regionEmojis[dest.region] || '🗾';
---

<DestinationLayout title={title} description={description} image={imageUrl}>
<style>
  /* ヒーロー */
  .hero { position: relative; background: #f0f0f0; overflow: hidden; }
  .hero img { width: 100%; height: 320px; object-fit: cover; display: block; }
  .hero-placeholder {
    width: 100%; height: 240px;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 12px;
  }

  /* コンテンツ幅 */
  .content { max-width: 640px; margin: 0 auto; padding: 0 24px 80px; }

  /* パンくず */
  .breadcrumb {
    padding: 14px 0 8px;
    font-size: 11px;
    color: #aaa;
    display: flex; gap: 6px; align-items: center;
    letter-spacing: 0.05em;
  }
  .breadcrumb a { color: #aaa; }

  /* タイトルエリア */
  .dest-header { padding: 20px 0 24px; border-bottom: 1px solid #ebebeb; margin-bottom: 32px; }
  .dest-pref { font-size: 11px; color: #aaa; letter-spacing: 0.1em; margin-bottom: 8px; text-transform: uppercase; }
  .dest-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    margin-bottom: 12px;
  }
  .dest-catch {
    font-size: 14px;
    color: #888;
    line-height: 1.8;
    font-style: italic;
  }

  /* タグ */
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tag {
    padding: 3px 10px;
    border: 1px solid #ddd;
    color: #888;
    font-size: 11px;
    border-radius: 20px;
    letter-spacing: 0.05em;
  }

  /* リード文 */
  .lead {
    font-size: 15px;
    line-height: 2.1;
    color: #333;
    margin-bottom: 40px;
  }

  /* シーズン */
  .season-box {
    margin-bottom: 40px;
    padding: 20px 24px;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 13px;
    color: #555;
    line-height: 1.9;
  }
  .season-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #aaa;
    margin-bottom: 8px;
    display: block;
  }

  /* スポット見出し */
  .spots-header { margin-bottom: 40px; }
  .spots-header h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    padding-bottom: 16px;
    border-bottom: 1px solid #1a1a1a;
  }

  /* スポットセクション */
  .spot-section { margin-bottom: 56px; }
  .spot-num {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #aaa;
    margin-bottom: 6px;
  }
  .spot-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: #1a1a1a;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #ebebeb;
  }
  .spot-image {
    width: 100%;
    height: 240px;
    object-fit: cover;
    margin-bottom: 20px;
    border-radius: 2px;
  }
  .spot-body {
    font-size: 14px;
    line-height: 2.1;
    color: #444;
    margin-bottom: 20px;
  }
  .spot-body p { margin-bottom: 16px; }
  .spot-info {
    padding: 16px 20px;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 12px;
    color: #777;
    line-height: 1.9;
    white-space: pre-line;
    margin-bottom: 12px;
  }
  .spot-map {
    font-size: 12px;
    color: #888;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 2px;
  }

  /* モデルコース */
  .course-section { margin-bottom: 48px; }
  .course-section h2 {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin-bottom: 20px;
    color: #1a1a1a;
  }
  .course-card {
    padding: 20px 24px;
    border-radius: 4px;
    margin-bottom: 12px;
    font-size: 13px;
    line-height: 2;
    color: #444;
  }
  .course-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    margin-bottom: 10px;
    display: block;
    font-weight: 500;
  }
  .course-daytrip { background: #fafaf5; border-left: 3px solid #c8b87a; }
  .course-daytrip .course-label { color: #8a7a4a; }
  .course-onenight { background: #f5f5fa; border-left: 3px solid #8a8ac8; }
  .course-onenight .course-label { color: #4a4a8a; }

  /* ヒント */
  .tips-box {
    margin-bottom: 48px;
    padding: 20px 24px;
    background: #f8faf8;
    border-left: 3px solid #8ab88a;
    border-radius: 0 4px 4px 0;
    font-size: 13px;
    color: #444;
    line-height: 2;
  }
  .tips-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #6a8a6a;
    margin-bottom: 10px;
    display: block;
    font-weight: 500;
  }

  /* セパレーター */
  .section-divider {
    border: none;
    border-top: 1px solid #ebebeb;
    margin: 48px 0;
  }

  /* 行き方 */
  .access-section { margin-bottom: 48px; }
  .section-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.05em;
    margin-bottom: 24px;
    color: #1a1a1a;
  }
  .travel-times {
    background: #f8f8f8;
    border-radius: 4px;
    padding: 20px 24px;
    margin-bottom: 24px;
  }
  .travel-times-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #aaa;
    margin-bottom: 16px;
    display: block;
  }
  .travel-time-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #ebebeb;
    font-size: 13px;
  }
  .travel-time-row:last-child { border-bottom: none; }
  .travel-time-row span:first-child { color: #777; }
  .travel-time-row span:last-child { font-weight: 500; color: #1a1a1a; }

  .access-steps { display: flex; flex-direction: column; gap: 2px; }
  .access-step {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 4px;
    font-size: 13px;
    color: #444;
  }
  .access-step-icon { font-size: 18px; min-width: 24px; text-align: center; }
  .step-arrow { text-align: center; color: #ddd; font-size: 11px; padding: 2px 0; }

  /* 宿泊 */
  .hotel-section { margin-bottom: 48px; }
  .hotel-description {
    font-size: 13px;
    color: #777;
    margin-bottom: 20px;
    line-height: 1.9;
  }
  .hotel-buttons { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .btn-rakuten {
    display: block; padding: 16px 12px;
    background: #1a1a1a; color: #fff;
    text-align: center; border-radius: 4px;
    font-size: 13px; letter-spacing: 0.05em;
    transition: opacity 0.2s;
  }
  .btn-rakuten:hover { opacity: 0.8; }
  .btn-jalan {
    display: block; padding: 16px 12px;
    background: #fff; color: #1a1a1a;
    text-align: center; border-radius: 4px;
    font-size: 13px; letter-spacing: 0.05em;
    border: 1px solid #1a1a1a;
    transition: all 0.2s;
  }
  .btn-jalan:hover { background: #1a1a1a; color: #fff; }

  /* 近くの旅先 */
  .nearby-section { margin-bottom: 48px; }
  .nearby-list { display: flex; flex-direction: column; }
  .nearby-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #ebebeb;
    font-size: 14px;
  }
  .nearby-item:first-child { border-top: 1px solid #ebebeb; }
  .nearby-name { color: #1a1a1a; }
  .nearby-pref { color: #aaa; font-size: 11px; }

  /* CTA */
  .cta-section {
    padding: 40px 24px;
    background: #f8f8f8;
    border-radius: 4px;
    text-align: center;
    margin-bottom: 48px;
  }
  .cta-label { font-size: 11px; letter-spacing: 0.1em; color: #aaa; margin-bottom: 8px; display: block; }
  .cta-title {
    font-family: 'Noto Serif JP', serif;
    font-size: 18px;
    font-weight: 400;
    color: #1a1a1a;
    margin-bottom: 24px;
    letter-spacing: 0.05em;
  }
  .cta-btn {
    display: inline-block;
    padding: 14px 36px;
    background: #1a1a1a;
    color: #fff;
    border-radius: 2px;
    font-size: 13px;
    letter-spacing: 0.1em;
    transition: opacity 0.2s;
  }
  .cta-btn:hover { opacity: 0.8; }
</style>

  <!-- ヒーロー画像 -->
  <div class="hero">
    {imageUrl ? (
      <img src={imageUrl} alt={`${dest.name}の風景`} />
    ) : (
      <div class="hero-placeholder" style={`background: ${regionColor};`}>
        <div style="font-size: 56px;">{emoji}</div>
        <div style="font-size: 13px; color: #888; letter-spacing: 0.1em;">{dest.name}</div>
      </div>
    )}
  </div>

  <div class="content">

    <!-- パンくず -->
    <nav class="breadcrumb">
      <a href="/">HOME</a> ›
      <a href="/destinations/">{dest.region || dest.prefecture}</a> ›
      <span>{dest.name}</span>
    </nav>

    <!-- タイトルエリア -->
    <div class="dest-header">
      <p class="dest-pref">{dest.prefecture}</p>
      <h1 class="dest-title">{title}</h1>
      {(dest as any).catch && <p class="dest-catch">{(dest as any).catch}</p>}
      <div class="tags">
        {dest.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    <!-- リード文 -->
    {article?.lead && <p class="lead">{article.lead}</p>}

    <!-- おすすめシーズン -->
    {article?.bestSeason && (
      <div class="season-box">
        <span class="season-label">BEST SEASON</span>
        {article.bestSeason}
      </div>
    )}

    <!-- スポット -->
    {article?.sections && article.sections.length > 0 && (
      <div>
        <div class="spots-header">
          <h2>{dest.name}のおすすめスポット</h2>
        </div>
        {article.sections.map((section: any, i: number) => (
          <div class="spot-section">
            <p class="spot-num">0{i + 1}</p>
            <h3 class="spot-title">{section.title || section.heading}</h3>
            {imageUrl && i === 0 && (
              <img src={imageUrl} alt={section.imageAlt || dest.name} class="spot-image" />
            )}
            <div class="spot-body">
              {section.body.split('\n').map((p: string) => p.trim()).filter(Boolean).map((p: string) => (
                <p>{p}</p>
              ))}
            </div>
            {section.info && <div class="spot-info">{section.info}</div>}
            <a
              href={`https://www.google.com/maps/search/${encodeURIComponent((section.title || section.heading || '') + ' ' + dest.name)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="spot-map"
            >地図で見る →</a>
          </div>
        ))}
      </div>
    )}

    <!-- モデルコース -->
    {article?.modelCourse && (
      <div class="course-section">
        <h2>モデルコース</h2>
        {article.modelCourse.daytrip && (
          <div class="course-card course-daytrip">
            <span class="course-label">DAY TRIP</span>
            {article.modelCourse.daytrip}
          </div>
        )}
        {article.modelCourse.onenight && (
          <div class="course-card course-onenight">
            <span class="course-label">1 NIGHT</span>
            {article.modelCourse.onenight}
          </div>
        )}
      </div>
    )}

    <!-- 旅のヒント -->
    {article?.tips && (
      <div class="tips-box">
        <span class="tips-label">TRAVEL TIPS</span>
        {typeof article.tips === 'string' ? article.tips : article.tips.join('\n')}
      </div>
    )}

    <hr class="section-divider" />

    <!-- 行き方 -->
    <div class="access-section">
      <h2 class="section-title">{dest.name}への行き方</h2>
      {travelTimes.length > 0 && (
        <div class="travel-times">
          <span class="travel-times-label">ACCESS TIME</span>
          {travelTimes.map(({ city, min }: { city: string; min: number }) => (
            <div class="travel-time-row">
              <span>{city}から</span>
              <span>{min >= 60 ? `約${Math.floor(min/60)}時間${min%60 > 0 ? min%60 + '分' : ''}` : `約${min}分`}</span>
            </div>
          ))}
        </div>
      )}
      {dest.access?.steps && dest.access.steps.length > 0 && (
        <div class="access-steps">
          {dest.access.steps.map((step: any, i: number) => (
            <>
              <div class="access-step">
                <span class="access-step-icon">
                  {step.type === 'rail' ? '🚃' : step.type === 'ferry' ? '⛴️' : step.type === 'flight' ? '✈️' : step.type === 'bus' ? '🚌' : step.type === 'car' ? '🚗' : '🚶'}
                </span>
                <span>{(step.to || step.from) + 'へ'}</span>
              </div>
              {i < dest.access.steps.length - 1 && <div class="step-arrow">↓</div>}
            </>
          ))}
        </div>
      )}
    </div>

    <hr class="section-divider" />

    <!-- 宿泊 -->
    {(dest.hotelLinks?.rakuten || dest.hotelLinks?.jalan) && (
      <div class="hotel-section">
        <h2 class="section-title">{(dest as any).hotelSearch || dest.name}の宿を探す</h2>
        <p class="hotel-description">
          {dest.stayAllowed?.includes('1night')
            ? `せっかく${dest.name}まで来たなら、1泊してゆっくり楽しみましょう。`
            : `${dest.name}周辺の宿泊施設を探してみましょう。`}
        </p>
        <div class="hotel-buttons">
          {dest.hotelLinks?.rakuten && (
            <a href={dest.hotelLinks.rakuten} target="_blank" rel="noopener noreferrer" class="btn-rakuten">楽天トラベル</a>
          )}
          {dest.hotelLinks?.jalan && (
            <a href={dest.hotelLinks.jalan} target="_blank" rel="noopener noreferrer" class="btn-jalan">じゃらん</a>
          )}
        </div>
      </div>
    )}

    <hr class="section-divider" />

    <!-- 近くの旅先 -->
    <div class="nearby-section">
      <h2 class="section-title">近くの旅先</h2>
      <div class="nearby-list">
        {(destinations as any[])
          .filter((d: any) => d.id !== dest.id && d.region === dest.region)
          .slice(0, 5)
          .map((d: any) => (
            <a href={`/destinations/${d.id}/`} class="nearby-item">
              <span class="nearby-name">{d.name}</span>
              <span class="nearby-pref">{d.prefecture} →</span>
            </a>
          ))
        }
      </div>
    </div>

    <!-- CTA -->
    <div class="cta-section">
      <span class="cta-label">TRAVEL PLANNING</span>
      <p class="cta-title">旅先を1分で決めてみる？</p>
      <a href="https://tabidokoiko.com" class="cta-btn">どこ行こ？で旅先を探す →</a>
    </div>

  </div>
</DestinationLayout>
